# Your Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Shared secret the iOS app must send as "Authorization: Bearer <APP_SHARED_SECRET>".
# This is NOT per-user auth -- it just stops randoms who don't have the app from
# hitting your Claude spend. Generate one with: openssl rand -hex 32
APP_SHARED_SECRET=change-me

# Port the server listens on
PORT=3000

# Comma-separated list of allowed origins for CORS (mainly relevant if you ever
# add a web client; the iOS app doesn't send an Origin header).
ALLOWED_ORIGINS=
